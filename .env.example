# continuum — .env 템플릿 (커밋용, placeholder 만). 복사: cp .env.example .env.<env>
# 실 비밀번호·토큰·키는 절대 기입 금지 — dev+ 는 Vault/Secret Manager 로 주입
ENV=local                         # local | dev | staging | prod

# 포트·바인드 (docker-compose ${VAR:-default} 의 단일 출처)
BIND_HOST=127.0.0.1               # LAN/외부 노출 시만 0.0.0.0
API_PORT=8080                     # Controller 호스트 노출 포트
POSTGRES_PORT=5432

# Controller / Agent / CLI
CONTROLLER_ADDR=127.0.0.1:8080    # listen 주소 (컨테이너 안은 :8080)
CONTROLLER_URL=http://localhost:8080
LOG_LEVEL=debug

# DB — local: SQLite(로컬 디스크 전용) / dev+: PostgreSQL
DATABASE_URL=sqlite:///./local.db
# DATABASE_URL=postgresql://<USER>:<PASSWORD>@<HOST>:5432/<DB>?sslmode=require
POSTGRES_USER=<POSTGRES_USER>
POSTGRES_PASSWORD=<POSTGRES_PASSWORD>
POSTGRES_DB=continuum

# mTLS (staging/prod) — 파일 경로만. 인증서·키 파일 커밋 금지
TLS_CERT_FILE=
TLS_KEY_FILE=
CA_CERT_FILE=

# Web UI → Controller
VITE_CONTROLLER_URL=http://127.0.0.1:8080

# Agents (P3, FR-N01/N08) — mTLS endpoint; AGENT_PORT is the host port compose publishes
AGENT_PORT=8443
CONTINUUM_AGENT_URL=https://controller:8443
# CONTINUUM_ENROLL_TOKEN=<from `continuum node token`>   # first start of the compose agent only
